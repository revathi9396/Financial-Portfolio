{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2018", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "ignoreDeprecations": "5.0",
    "target": "ES2022",
    "noImplicitAny": true
    // "suppressImplicitAnyIndexErrors": true
  },
  "angularCompilerOptions": {
    "enableIvy": true
  }
}
